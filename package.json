{
  "name": "bloub-tarot",
  "version": "0.1.0",
  "private": true,
  "description": "A tarot reader played by bloub: curtain, one question, three cards, one morphing ball.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "favicon": "node scripts/favicon.mjs",
    "og": "node scripts/og.mjs"
  },
  "dependencies": {
    "bloub-react": "file:../bloub-react",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.0",
    "wrangler": "^4.131.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}